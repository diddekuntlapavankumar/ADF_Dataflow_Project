						"parameters": {
							"startdate": "[parameters('pipelinedailytrigger_properties_PL_Copy_pipelineparameter_sqldatabase_sqldatabase_scdtrigger_parameters_startdate')]",
							"enddate": "[parameters('pipelinedailytrigger_properties_PL_Copy_pipelineparameter_sqldatabase_sqldatabase_scdtrigger_parameters_enddate')]"
						}
					},
					{
						"pipelineReference": {
							"referenceName": "pl_copy_pipelineparameter_datalake_sqldatabase_scdtrigger",
							"type": "PipelineReference"
						},
						"parameters": {
							"startdate": "[parameters('pipelinedailytrigger_properties_pl_copy_pipelineparameter_datalake_sqldatabase_scdtrigger_parameters_startdate')]",
							"enddate": "[parameters('pipelinedailytrigger_properties_pl_copy_pipelineparameter_datalake_sqldatabase_scdtrigger_parameters_enddate')]"
						}
					}
				],
				"type": "ScheduleTrigger",
				"typeProperties": {
					"recurrence": {
						"frequency": "Minute",
						"interval": 5,
						"startTime": "2026-05-06T16:30:00",
						"timeZone": "India Standard Time"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/TRG_FileUpload')]",
			"type": "Microsoft.DataFactory/factories/triggers",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"runtimeState": "Stopped",
				"pipelines": [
					{
						"pipelineReference": {
							"referenceName": "PL_Copy_CustomerData_event_trigger",
							"type": "PipelineReference"
						},
						"parameters": {}
					}
				],
				"type": "BlobEventsTrigger",
				"typeProperties": {
					"blobPathBeginsWith": "/pacontainer/blobs/container",
					"blobPathEndsWith": "customer_data2.txt",
					"ignoreEmptyBlobs": true,
					"scope": "[parameters('TRG_FileUpload_properties_typeProperties_scope')]",
					"events": [
						"Microsoft.Storage.BlobCreated"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/PL_Copy_CustomerData_event_trigger')]"
			]
		}
	]
