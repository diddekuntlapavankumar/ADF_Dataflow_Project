{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dpavanadfproject"
		},
		"pipelinedailytrigger_properties_PL_Copy_pipeline_Employee_Data_parameters_startdate": {
			"type": "string",
			"defaultValue": "@formatDateTime(addDays(trigger().scheduledTime,-1),'yyyy-MM-dd')"
		},
		"pipelinedailytrigger_properties_PL_Copy_pipeline_Employee_Data_parameters_enddate": {
			"type": "string",
			"defaultValue": "@formatDateTime(trigger().scheduledTime,'yyyy-MM-dd')"
		},
		"pipelinedailytrigger_properties_pipeline2_parameters_startdate": {
			"type": "string",
			"defaultValue": "@formatDateTime(addDays(trigger().scheduledTime,-1),'yyyy-MM-dd')"
		},
		"pipelinedailytrigger_properties_pipeline2_parameters_enddate": {
			"type": "string",
			"defaultValue": "@formatDateTime(trigger().scheduledTime,'yyyy-MM-dd')"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pipelinedailytrigger')]",
			"type": "Microsoft.DataFactory/factories/triggers",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"runtimeState": "Stopped",
				"pipelines": [
					{
						"pipelineReference": {
							"referenceName": "PL_Copy_pipeline_Employee_Data",
							"type": "PipelineReference"
						},
						"parameters": {
							"startdate": "[parameters('pipelinedailytrigger_properties_PL_Copy_pipeline_Employee_Data_parameters_startdate')]",
							"enddate": "[parameters('pipelinedailytrigger_properties_PL_Copy_pipeline_Employee_Data_parameters_enddate')]"
						}
					},
					{
						"pipelineReference": {
							"referenceName": "pipeline2",
							"type": "PipelineReference"
						},
						"parameters": {
							"startdate": "[parameters('pipelinedailytrigger_properties_pipeline2_parameters_startdate')]",
							"enddate": "[parameters('pipelinedailytrigger_properties_pipeline2_parameters_enddate')]"
						}
					}
				],
				"type": "ScheduleTrigger",
				"typeProperties": {
					"recurrence": {
						"frequency": "Minute",
						"interval": 5,
						"startTime": "2026-05-06T16:30:00",
						"timeZone": "India Standard Time"
					}
				}
			},
			"dependsOn": []
		}
	]
}