{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dpavanadfproject"
		},
		"pipelinedailytrigger_properties_PL_Copy_pipelineparameter_sqldatabase_sqldatabase_scdtrigger_parameters_startdate": {
			"type": "string",
			"defaultValue": "@formatDateTime(addDays(trigger().scheduledTime,-1),'yyyy-MM-dd')"
		},
		"pipelinedailytrigger_properties_PL_Copy_pipelineparameter_sqldatabase_sqldatabase_scdtrigger_parameters_enddate": {
			"type": "string",
			"defaultValue": "@formatDateTime(trigger().scheduledTime,'yyyy-MM-dd')"
		},
		"pipelinedailytrigger_properties_pl_copy_pipelineparameter_datalake_sqldatabase_scdtrigger_parameters_startdate": {
			"type": "string",
			"defaultValue": "@formatDateTime(addDays(trigger().scheduledTime,-1),'yyyy-MM-dd')"
		},
		"pipelinedailytrigger_properties_pl_copy_pipelineparameter_datalake_sqldatabase_scdtrigger_parameters_enddate": {
			"type": "string",
			"defaultValue": "@formatDateTime(trigger().scheduledTime,'yyyy-MM-dd')"
		},
		"TRG_FileUpload_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/4e1cb213-da1f-482f-8451-90b7378304e4/resourceGroups/Resource_group_dev/providers/Microsoft.Storage/storageAccounts/bronzeadlsstorage"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
